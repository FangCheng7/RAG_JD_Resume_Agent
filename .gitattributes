# 统一换行符，避免 Windows / Linux 之间来回变动
* text=auto eol=lf

*.py        text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# 二进制文件不做换行转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.docx      binary
*.bin       binary
*.safetensors binary
*.exe       binary
*.dll       binary
*.pyd       binary