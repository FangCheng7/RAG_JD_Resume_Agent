# ============================================================
# TalentMatch AI
# Environment Example
# ============================================================

# DeepSeek API
DEEPSEEK_API_KEY=

# DeepSeek Base URL
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Default Model
DEEPSEEK_MODEL=deepseek-chat


# ============================================================
# RAG
# ============================================================

# Embedding
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Chunk
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval
TOP_K=12

# Maximum document characters sent to LLM
MAX_DOCUMENT_CHARS=50000 